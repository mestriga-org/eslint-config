{
	"name": "@mestriga-org/eslint-config",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.15.0",
	"exports": "./index.js",
	"types": "./index.d.ts",
	"files": [
		"index.d.ts",
		"index.js"
	],
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.12.1",
			"onFail": "download"
		}
	},
	"engines": {
		"npm": "<0"
	},
	"scripts": {
		"lint": "NODE_OPTIONS=$NODE_OPTIONS' --disable-proto=throw --permission --allow-fs-read=* --allow-worker' eslint --max-warnings=0 --concurrency=auto --flag=unstable_native_nodejs_ts_config"
	},
	"dependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"eslint-plugin-erasable-syntax-only": "^0.7.2"
	},
	"devDependencies": {
		"eslint": "catalog:"
	}
}
