{
	"name": "@mestriga-org/eslint-config",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@12.10.1",
	"exports": "./index.js",
	"types": "./index.d.ts",
	"files": [
		"index.d.ts",
		"index.js"
	],
	"engines": {
		"npm": "<0"
	},
	"scripts": {
		"lint": "NODE_OPTIONS=$NODE_OPTIONS' --no-addons --frozen-intrinsics --disable-proto=throw --permission --allow-fs-read=* --allow-fs-write=node_modules/.cache/eslint/* --allow-net --allow-worker' eslint --max-warnings=0 --concurrency=auto --flag=unstable_native_nodejs_ts_config"
	},
	"dependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"eslint-plugin-erasable-syntax-only": "^0.7.2",
		"eslint-plugin-json-schema-validator": "^6.3.1"
	},
	"devDependencies": {
		"eslint": "10.11.0"
	}
}
